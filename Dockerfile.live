# 0102: requires exact accepted image IDs and sealed runtime staged by the bundle.
ARG CLI_IMAGE
ARG PARENT_IMAGE
# Previously accepted gRPC binary; pin/check its bytes below.
ARG GRPC_IMAGE=xbt-grpc-repair-donor:20261106
FROM ${GRPC_IMAGE} AS grpc
FROM ${CLI_IMAGE} AS cli
FROM ${PARENT_IMAGE}
USER root
RUN rm -rf /usr/local/libexec/swap-node
COPY runtime/ /usr/local/libexec/swap-node/
COPY --from=cli /usr/bin/bitcoin-cli /usr/local/bin/bitcoin-cli
ENV PATH="/opt/xbt/bin:${PATH}"
RUN ln -sf /opt/xbt/bin/lightning-cli /usr/local/bin/lightning-cli && ln -sf /opt/xbt/bin/lightningd /usr/local/bin/lightningd

COPY --from=grpc /usr/local/libexec/c-lightning/plugins/cln-grpc /opt/xbt/libexec/c-lightning/plugins/cln-grpc
RUN echo "0b4774e23b8eb81e79fabc0602a43cc53bac962fe229533098b258fd72a4ae06  /opt/xbt/libexec/c-lightning/plugins/cln-grpc" | sha256sum -c -
