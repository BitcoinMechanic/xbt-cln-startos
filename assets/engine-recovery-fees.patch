--- a/bitcoin/tx.c
+++ b/bitcoin/tx.c
@@ -935,8 +935,13 @@
 		 * to `1` and witness: <remote_sig>
 		 * Otherwise, this output is a simple P2WPKH to `remotepubkey`.
 		 */
-		/* In practice, these predate anchors, so: */
-		return 1 + 1 + bitcoin_tx_input_sig_weight();
+		/* The witness also contains the witness script.  Its compressed
+		 * pubkey push takes 34 bytes, CHECKSIGVERIFY and CSV one each,
+		 * and the CSV value up to three (for a channel lease).  Use the
+		 * largest script accepted by is_to_remote_anchored_witness_script.
+		 * Non-anchor close outputs are P2WPKH and handled above.
+		 * bitcoin_tx_input_weight adds the witness element count. */
+		return bitcoin_tx_input_sig_weight() + 1 + 34 + 1 + 3 + 1;
 	case UTXO_P2TR:
 		/* Unified Schnorr signatures include an explicit sighash byte. */
 		return 1 + 64 + !is_elements(chainparams);
