diff --git a/apps/backend/source/service/fiat-rates.ts b/apps/backend/source/service/fiat-rates.ts
new file mode 100644
index 0000000..50ba140
--- /dev/null
+++ b/apps/backend/source/service/fiat-rates.ts
@@ -0,0 +1,57 @@
+import axios from 'axios';
+
+// Fixed public market requests only: never accept wallet amounts, addresses or invoices.
+export const XBT_TICKER_URL = 'https://neoxa.exchange/api/exchange/ticker/BTCB2_USDC';
+export const USD_FX_URL = 'https://api.frankfurter.dev/v1/latest?base=USD';
+const MAX_AGE_MS = 15 * 60 * 1000;
+const CACHE_MS = 5 * 60 * 1000;
+type FetchJson = (url: string) => Promise<any>;
+const fetchJson: FetchJson = async url => (await axios.get(url, {
+  timeout: 10000, maxContentLength: 262144, maxRedirects: 0,
+  headers: { Accept: 'application/json', 'User-Agent': 'XBT-CLN-UI/1.0' },
+})).data;
+
+export function createXbtRateProvider(fetch: FetchJson = fetchJson, clock = Date.now) {
+  let cached: { rates: Record<string, number>; timestamp: number; fetchedAt: number } | undefined;
+  let pending: Promise<void> | undefined;
+  const fresh = (timestamp: number, now: number) => Number.isSafeInteger(timestamp)
+    && timestamp >= now - MAX_AGE_MS && timestamp <= now + 300000;
+  const positive = (value: unknown) => (typeof value === 'number' || typeof value === 'string')
+    && value !== '' && Number.isFinite(Number(value)) && Number(value) > 0;
+  async function refresh() {
+    const now = clock();
+    const data = await fetch(XBT_TICKER_URL);
+    if (data?.success !== true || data?.pair !== 'BTCB2_USDC'
+      || !fresh(data?.ticker?.computedAt, now) || !positive(data?.ticker?.lastPrice)) {
+      throw new Error('Neoxa XBT quote is invalid or stale');
+    }
+    const rates: Record<string, number> = { USD: Number(data.ticker.lastPrice) };
+    try {
+      const fx = await fetch(USD_FX_URL);
+      const date = typeof fx?.date === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(fx.date)
+        ? Date.parse(fx.date + 'T00:00:00Z') : NaN;
+      if (fx?.base !== 'USD' || !Number.isFinite(date) || date > now + 86400000
+        || date < now - 7 * 86400000 || !fx?.rates || typeof fx.rates !== 'object') {
+        throw new Error('Invalid FX table');
+      }
+      for (const [currency, value] of Object.entries(fx.rates)) {
+        if (/^[A-Z]{3}$/.test(currency) && currency !== 'USD' && positive(value)
+          && positive(rates.USD * Number(value))) rates[currency] = rates.USD * Number(value);
+      }
+    } catch { /* Keep USD available when the separate FX service is unavailable. */ }
+    cached = { rates, timestamp: data.ticker.computedAt, fetchedAt: now };
+  }
+  return async (currency: string) => {
+    const now = clock();
+    if (!cached || now - cached.fetchedAt >= CACHE_MS || !fresh(cached.timestamp, now)) {
+      if (!pending) pending = refresh().finally(() => { pending = undefined; });
+      await pending;
+    }
+    if (!cached || !fresh(cached.timestamp, clock()) || !positive(cached.rates[currency])) {
+      throw new Error('XBT fiat rate unavailable');
+    }
+    return { rate: cached.rates[currency], available: true, timestamp: cached.timestamp,
+      source: 'neoxa.exchange', pair: 'BTCB2_USDC' };
+  };
+}
+export const getXbtFiatRate = createXbtRateProvider();
