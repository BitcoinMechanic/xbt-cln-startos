diff --git a/apps/frontend/src/components/cln/ChannelDetails/ChannelLabel.tsx b/apps/frontend/src/components/cln/ChannelDetails/ChannelLabel.tsx
new file mode 100644
index 0000000..3e70bd2
--- /dev/null
+++ b/apps/frontend/src/components/cln/ChannelDetails/ChannelLabel.tsx
@@ -0,0 +1,37 @@
+import { useEffect, useState } from 'react';
+import { Form, Alert, InputGroup } from 'react-bootstrap';
+import { useDispatch } from 'react-redux';
+import { HttpService } from '../../../services/http.service';
+import { setChannelLabel } from '../../../store/rootSlice';
+
+export default function ChannelLabel({ channel }) {
+  const dispatch = useDispatch();
+  const [label, setLabel] = useState(channel.channel_label || '');
+  const [editing, setEditing] = useState(false);
+  const [saving, setSaving] = useState(false);
+  const [message, setMessage] = useState('');
+  const [error, setError] = useState('');
+  useEffect(() => { if (!editing) setLabel(channel.channel_label || ''); }, [channel.channel_label, editing]);
+  const save = async () => {
+    if (saving) return;
+    setSaving(true); setMessage(''); setError('');
+    try {
+      const result: any = await HttpService.clnCall('setchannellabel', { channel_id: channel.channel_id, label });
+      dispatch(setChannelLabel(result));
+      setEditing(false); setMessage(result.label ? 'Channel label saved.' : 'Channel label removed.');
+    } catch (e) { setError('Could not save channel label: ' + String(e)); }
+    finally { setSaving(false); }
+  };
+  return <section className="mt-3 mb-3" data-testid="channel-label-editor">
+    <Form.Label className="text-dark" htmlFor="channel-label">Channel label</Form.Label>
+    <InputGroup><Form.Control id="channel-label" maxLength={80} value={label} disabled={saving}
+      placeholder="Optional" onChange={e => { setLabel(e.target.value); setEditing(true); setMessage(''); }} /></InputGroup>
+    <div className="fs-7 text-light mt-1">Private to your node. Leave blank to use the peer alias.</div>
+    <div className="d-flex gap-2 mt-2">
+      <button type="button" className="btn-rounded bg-primary" onClick={save} disabled={saving || !editing}>{saving ? 'Saving…' : 'Save label'}</button>
+      {editing && <button type="button" className="btn-rounded" disabled={saving} onClick={() => { setEditing(false); setError(''); }}>Cancel</button>}
+    </div>
+    {message && <p role="status" className="mt-2">{message}</p>}
+    {error && <Alert variant="danger" className="mt-2">{error}</Alert>}
+  </section>;
+}
diff --git a/apps/frontend/src/components/cln/ChannelDetails/SpliceChannel.tsx b/apps/frontend/src/components/cln/ChannelDetails/SpliceChannel.tsx
new file mode 100644
index 0000000..448f7a4
--- /dev/null
+++ b/apps/frontend/src/components/cln/ChannelDetails/SpliceChannel.tsx
@@ -0,0 +1,82 @@
+import { useRef, useState } from 'react';
+import { Alert, Form, InputGroup } from 'react-bootstrap';
+import { HttpService } from '../../../services/http.service';
+
+// Keep an unresolved submission visible even after closing the channel drawer.
+export default function SpliceChannel({ channel }) {
+  const key = 'splice:' + channel.channel_id;
+  const [direction, setDirection] = useState('splicein');
+  const [amount, setAmount] = useState('');
+  const [review, setReview] = useState(false);
+  const [record, setRecord] = useState(() => JSON.parse(localStorage.getItem(key) || 'null'));
+  const [settled, setSettled] = useState(false);
+  const [aborted, setAborted] = useState(false);
+  const [status, setStatus] = useState('');
+  const submitting = useRef(false);
+  const confirmed = settled || (!!record?.txid && channel.state === 'CHANNELD_NORMAL' && channel.funding_txid === record.txid);
+  const save = (value) => { localStorage.setItem(key, JSON.stringify(value)); setRecord(value); };
+  const valid = /^[1-9][0-9]{0,15}$/.test(amount) && Number.isSafeInteger(Number(amount));
+  const available = channel.state === 'CHANNELD_NORMAL' && channel.peer_connected !== false;
+  const submit = async () => {
+    if (!valid || !available || record || submitting.current) return;
+    submitting.current = true;
+    setReview(false);
+    const pending = { direction, amount, funding: channel.funding_txid, time: new Date().toISOString() };
+    save(pending);
+    setStatus('Negotiating splice with the peer. Do not submit another splice.');
+    try {
+      const result: any = await HttpService.clnCall(direction, { channel: channel.channel_id, amount });
+      save({ ...pending, txid: result.txid, result: result.txid ? 'Broadcast; waiting for confirmations.' : 'Node returned without a transaction ID; check channel status before retrying.' });
+      setStatus('');
+    } catch (error) {
+      save({ ...pending, error: String(error) });
+      setStatus('');
+    } finally { submitting.current = false; }
+  };
+  const refresh = async () => {
+    try {
+      const result: any = await HttpService.clnCall('listpeerchannels', { id: channel.peer_id });
+      const current = result.channels.find(c => c.channel_id === channel.channel_id);
+      if (!current) { setStatus('Channel not found. Do not repeat the splice.'); return; }
+      setAborted(!!record?.error && current.state === 'CHANNELD_NORMAL' && !current.inflight?.length && current.funding_txid === record.funding);
+      setSettled(current.state === 'CHANNELD_NORMAL' && !current.inflight?.length && !!record?.txid && current.funding_txid === record.txid);
+      setStatus('State: ' + current.state + '; capacity: ' + (Number(current.total_msat) / 1000).toLocaleString() +
+        ' sats; funding transaction: ' + current.funding_txid + '; pending splices: ' + (current.inflight?.length || 0));
+    } catch (error) { setStatus('Status check failed: ' + String(error)); }
+  };
+  if (!record && channel.state === 'CHANNELD_AWAITING_SPLICE') return null;
+  return <section className="mt-4 mb-3" aria-label="Splice channel">
+    <h5>Splice channel</h5>
+    <p className="fs-7">Add on-chain funds or withdraw local funds without closing the channel. Both nodes must support splicing.</p>
+    {record ? <Alert variant={record.error ? 'warning' : 'info'}>
+      <div>{record.direction === 'splicein' ? 'Splice in' : 'Splice out'}: {Number(record.amount).toLocaleString()} sats</div>
+      <div>{record.time}</div>
+      <div style={{ overflowWrap: 'anywhere' }}>{confirmed ? 'Splice confirmed.' : (record.error || record.result || 'Submission in progress or outcome unknown.')}</div>
+      {record.txid && <div style={{ overflowWrap: 'anywhere' }}>Transaction: {record.txid}</div>}
+      <p>Check the channel and transaction before any further splice. A lost reply does not mean it failed.</p>
+      <button type="button" className="btn-rounded bg-primary" onClick={refresh}>Refresh splice status</button>
+      {aborted && <div className="mt-2"><p>The node reports the original funding transaction and no pending splice. Check wallet transactions before dismissing this failed attempt.</p><button type="button" className="btn-rounded" onClick={() => {
+        const history = JSON.parse(localStorage.getItem(key + ':history') || '[]');
+        localStorage.setItem(key + ':history', JSON.stringify([...history, record].slice(-20)));
+        localStorage.removeItem(key); setRecord(null); setAborted(false);
+      }}>Dismiss failed attempt</button></div>}
+      {confirmed && <button type="button" className="btn-rounded mt-2" onClick={() => { localStorage.removeItem(key); setRecord(null); setSettled(false); }}>Splice confirmed — dismiss result</button>}
+    </Alert> : <>
+      <Form.Label className="text-dark" htmlFor="splice-direction">Direction</Form.Label>
+      <InputGroup><Form.Select className="form-control" id="splice-direction" value={direction} onChange={e => { setDirection(e.target.value); setReview(false); }}>
+        <option value="splicein">Add funds from on-chain wallet</option>
+        <option value="spliceout">Withdraw funds to on-chain wallet</option>
+      </Form.Select></InputGroup>
+      <Form.Label className="mt-2 text-dark" htmlFor="splice-amount">Amount in sats</Form.Label>
+      <InputGroup><Form.Control id="splice-amount" inputMode="numeric" value={amount} onChange={e => { setAmount(e.target.value); setReview(false); }} /></InputGroup>
+      <p className="fs-7 mt-2">{direction === 'splicein' ? 'The network fee is paid separately from the on-chain wallet.' : 'The network fee is also deducted from channel funds.'} Core Lightning selects the fee rate with its normal fee safety checks.</p>
+      {!available && <p>Connect the peer and wait for the channel to become active before splicing.</p>}
+      {review ? <Alert variant="warning">
+        <p>Confirm {direction === 'splicein' ? 'adding' : 'withdrawing'} {Number(amount).toLocaleString()} sats {direction === 'splicein' ? 'to' : 'from'} this channel, plus the network fee?</p>
+        <button type="button" className="btn-rounded bg-primary me-2" onClick={submit}>Confirm splice</button>
+        <button type="button" className="btn-rounded" onClick={() => setReview(false)}>Cancel</button>
+      </Alert> : <button type="button" className="btn-rounded bg-primary" disabled={!valid || !available} onClick={() => setReview(true)}>Review splice</button>}
+    </>}
+    {status && <p role="status" style={{ overflowWrap: 'anywhere' }}>{status}</p>}
+  </section>;
+}
diff --git a/apps/frontend/src/components/cln/ChannelDetails/SpliceStatus.tsx b/apps/frontend/src/components/cln/ChannelDetails/SpliceStatus.tsx
new file mode 100644
index 0000000..b850180
--- /dev/null
+++ b/apps/frontend/src/components/cln/ChannelDetails/SpliceStatus.tsx
@@ -0,0 +1,18 @@
+export default function SpliceStatus({ channel, detailed = false }) {
+  if (channel.state !== 'CHANNELD_AWAITING_SPLICE') return null;
+  const pending = channel.pending_splices || [];
+  return <div className="mt-2 mb-2 fs-7" role="status" aria-label="Pending splice">
+    {pending.length ? pending.map(splice => <div key={splice.txid} className="mb-2">
+      <div className="fw-bold text-warning">Splice pending: {splice.delta > 0 ? '+' : ''}{splice.delta.toLocaleString()} sats</div>
+      <div className="text-dark">{splice.confirmations === null ? 'Confirmation count unavailable' :
+        splice.confirmations === 0 ? '0 confirmations · waiting to be mined' :
+        splice.confirmations.toLocaleString() + (splice.confirmations === 1 ? ' confirmation' : ' confirmations') + ' · waiting for both peers to lock the splice'}</div>
+      {detailed && <>
+        <div className="text-dark">Channel capacity after splice: {splice.capacity.toLocaleString()} sats</div>
+        <div className="text-light" style={{ overflowWrap: 'anywhere' }}>Splice transaction: {splice.txid}</div>
+      </>}
+    </div>) : <div className="fw-bold text-warning">Splice pending · waiting for both peers to lock the splice</div>}
+    {detailed && <div className="text-light">Balances above show the current funding. The new capacity is pending. The peer’s required confirmation count is not reported by Core Lightning.</div>}
+    {channel.splice_status_error && <div className="text-danger">Confirmation lookup failed: {channel.splice_status_error}</div>}
+  </div>;
+}
