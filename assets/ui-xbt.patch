+      features.length > 16384 || !/^(?:[0-9a-fA-F]{2})+$/.test(features)) {
+    throw new Error('Use an XBT BOLT11 invoice');
+  }
+  const bits = BigInt('0x' + features);
+  if (!(bits & (1n << 512n)) || (bits & (1n << 513n))) throw new Error('This invoice is not for the XBT chain');
+}
