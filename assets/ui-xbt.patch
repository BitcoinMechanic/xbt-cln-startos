@@ -0,0 +1,31 @@
+import { nodeUris, pendingSplices } from './channel-status';
+
+const id = '02' + 'a'.repeat(64);
+test('only advertised listening endpoints become node URIs, including IPv6 and Tor', () => {
+  expect(nodeUris(id, [
+    {type:'ipv4',address:'192.168.8.102',port:9735},
+    {type:'ipv6',address:'2001:db8::1',port:9735},
+    {type:'torv3',address:'a'.repeat(56)+'.onion',port:9735},
+    {type:'ipv4',address:'127.0.0.1',port:0},
+    {type:'ipv4',address:'0.0.0.0',port:9735},
+    {type:'ipv6',address:'::',port:9735},
+    {type:'ipv4',address:'127.0.0.1',port:9735},
+    {type:'websocket',address:'unknown',port:9735},
+  ])).toEqual([id+'@192.168.8.102:9735',id+'@[2001:db8::1]:9735',id+'@'+'a'.repeat(56)+'.onion:9735']);
+  expect(nodeUris(id)).toEqual([]);
+  expect(nodeUris('invalid', [{type:'ipv4',address:'127.0.0.1',port:9735}])).toEqual([]);
+});
+const channel = {state:'CHANNELD_AWAITING_SPLICE',total_msat:9999834000,inflight:[{funding_txid:'tx',total_funding_msat:10999834000}]};
+test('pending amount and confirmations come from node state without browser history', () => {
+  expect(pendingSplices(channel,[['tx',0]],100)[0]).toEqual({txid:'tx',delta:1000000,capacity:10999834,confirmations:0});
+  expect(pendingSplices(channel,[['tx',98]],100)[0].confirmations).toBe(3);
+  expect(pendingSplices(channel,null,null)[0].confirmations).toBeNull();
+  expect(pendingSplices(channel,[],100)[0].confirmations).toBeNull();
+  expect(pendingSplices({...channel,state:'CHANNELD_NORMAL'},[['tx',98]],100)).toEqual([]);
+  expect(pendingSplices({...channel,total_msat:11999834000},[['tx',98]],100)[0].delta).toBe(-1000000);
+});
+
+test('node connection URIs preserve StartOS external port and never use a wildcard', () => {
+  expect(nodeUris(id, [{type:'ipv4',address:'192.168.8.102',port:64774}])).toEqual([id+'@192.168.8.102:64774']);
+  expect(nodeUris(id, [{type:'ipv4',address:'0.0.0.0',port:9735}])).toEqual([]);
+});
diff --git a/apps/frontend/src/utilities/channel-status.ts b/apps/frontend/src/utilities/channel-status.ts
new file mode 100644
index 0000000..949b705
--- /dev/null
+++ b/apps/frontend/src/utilities/channel-status.ts
@@ -0,0 +1,35 @@
+import { Address } from '../types/root.type';
+
+export function nodeUris(id: string, addresses: Address[] = []): string[] {
+  if (!/^(02|03)[0-9a-f]{64}$/i.test(id)) return [];
+  return [...new Set(addresses.filter(a =>
+    ['ipv4', 'ipv6', 'torv3', 'dns'].includes(a.type || '') &&
+    typeof a.address === 'string' &&
+    !['0.0.0.0', '::', '[::]', '::1', '[::1]', 'localhost'].includes(a.address.toLowerCase()) &&
+    !a.address.startsWith('127.') && /^[a-z0-9.:[\]-]+$/i.test(a.address) &&
+    Number.isInteger(a.port) && a.port! > 0 && a.port! <= 65535
+  ).map(a => {
+    const host = a.address!.includes(':') && !a.address!.startsWith('[') ? '[' + a.address + ']' : a.address;
+    return id + '@' + host + ':' + a.port;
+  }))];
+}
+
+export function pendingSplices(channel: any, rows: any[][] | null, tip: number | null) {
+  if (channel.state !== 'CHANNELD_AWAITING_SPLICE') return [];
+  return (channel.inflight || []).map((f: any) => {
+    const row = rows?.find(row => row[0] === f.funding_txid);
+    const height = row ? Number(row[1]) : null;
+    const confirmations = height !== null && tip !== null ? (height > 0 ? Math.max(0, tip - height + 1) : 0) : null;
+    const capacity = Number(f.total_funding_msat) / 1000;
+    return { txid: f.funding_txid, delta: capacity - Number(channel.total_msat) / 1000, capacity, confirmations };
+  });
+}
+
+// Balances are sats, while ProgressBar expects a percentage. Normalize before
+// rendering so large channels and one-sided balances use the same scale.
+export const localLiquidityPercent = (local: number, remote: number): number => {
+  const safeLocal = Number.isFinite(local) ? Math.max(0, local) : 0;
+  const safeRemote = Number.isFinite(remote) ? Math.max(0, remote) : 0;
+  const total = safeLocal + safeRemote;
+  return total > 0 ? safeLocal / total * 100 : 0;
+};
