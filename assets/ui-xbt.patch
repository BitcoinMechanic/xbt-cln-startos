--- /dev/null
+++ b/apps/backend/test/fiat-rates.test.mjs
@@ -0,0 +1,30 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { createXbtRateProvider, XBT_TICKER_URL, USD_FX_URL } from '../dist/service/fiat-rates.js';
+const now = Date.parse('2026-11-13T20:00:00Z');
+const ticker = (update = {}) => ({ success: true, pair: 'BTCB2_USDC', ticker: { computedAt: now, lastPrice: 250, ...update } });
+test('fixed price-only URLs; shared cache and local FX conversion', async () => {
+  const calls=[]; let time=now;
+  const rate=createXbtRateProvider(async url => { calls.push(url); return url===XBT_TICKER_URL ? ticker({computedAt:time}) : {base:'USD',date:'2026-11-13',rates:{CAD:1.4,USD:99}}; },()=>time);
+  const [usd,cad]=await Promise.all([rate('USD'),rate('CAD')]);
+  assert.equal(usd.rate,250);assert.equal(cad.rate,350);
+  assert.deepEqual(calls,[XBT_TICKER_URL,USD_FX_URL]);
+  await rate('USD');assert.equal(calls.length,2);
+  time+=300001;await rate('USD');assert.equal(calls.length,4);
+});
+test('rejects stale, wrong-market and invalid prices; never substitutes BTC', async () => {
+  for(const data of [ticker({computedAt:now-900001}),ticker({computedAt:now+300001}),ticker({lastPrice:0}),ticker({lastPrice:'NaN'}),ticker({lastPrice:true}),{...ticker(),pair:'BTC_USDC'}]) {
+    const rate=createXbtRateProvider(async url=>{assert.equal(url,XBT_TICKER_URL);return data;},()=>now);
+    await assert.rejects(rate('USD'));
+  }
+});
+test('FX outage preserves USD, never returns USD as another currency', async () => {
+  const rate=createXbtRateProvider(async url=>{if(url===XBT_TICKER_URL)return ticker();throw new Error('offline');},()=>now);
+  assert.equal((await rate('USD')).rate,250);await assert.rejects(rate('CAD'));
+});
+test('stale FX refused and expired cached prices are not served on network failure', async () => {
+  let time=now;let offline=false;
+  const rate=createXbtRateProvider(async url=>{if(offline)throw new Error('offline');return url===XBT_TICKER_URL?ticker():{base:'USD',date:'2025-01-01',rates:{CAD:1.4}};},()=>time);
+  await rate('USD');await assert.rejects(rate('CAD'));
+  time+=900001;offline=true;await assert.rejects(rate('USD'));
+});
