+				} else {
+					ns = realloc(stack, nmax * sizeof(*ns));
+				}
+				if (ns) {
+					stack = ns;
+					max = nmax;
+				} else {
+					/* OOM: finish this subtree
+					 * recursively. */
+					clear(*child);
+					if (tag == 0)
+						clear(slot->u.n->child[1]);
+					free(slot->u.n);
+					continue;
+				}
+			}
+			stack[num++] = (uintptr_t)slot | (tag + 1);
+			cur = (uintptr_t)child;
+			have_cur = true;
+		}
+	}
+
+	if (stack != inline_stack)
+		free(stack);
 	set->u.n = NULL;
 }
