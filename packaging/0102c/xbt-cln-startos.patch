+# 0102: requires exact accepted image IDs and sealed runtime staged by the bundle.
+ARG CLI_IMAGE
+ARG PARENT_IMAGE
+FROM ${CLI_IMAGE} AS cli
+FROM ${PARENT_IMAGE}
+USER root
+RUN rm -rf /usr/local/libexec/swap-node
+COPY runtime/ /usr/local/libexec/swap-node/
+COPY --from=cli /usr/bin/bitcoin-cli /usr/local/bin/bitcoin-cli
+ENV PATH="/opt/xbt/bin:${PATH}"
+RUN ln -sf /opt/xbt/bin/lightning-cli /usr/local/bin/lightning-cli && ln -sf /opt/xbt/bin/lightningd /usr/local/bin/lightningd
